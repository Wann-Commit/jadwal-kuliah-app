<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:id="@+id/etNamaMK"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nama Mata Kuliah"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hari"
            android:layout_marginTop="8dp"/>

        <Spinner
            android:id="@+id/spinnerHari"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <EditText
                android:id="@+id/etJamMulai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Jam Mulai (HH:MM)"
                android:focusable="false"
                android:clickable="true"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:id="@+id/etJamSelesai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Jam Selesai (HH:MM)"
                android:focusable="false"
                android:clickable="true"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:id="@+id/etRuangan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ruangan"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <EditText
                android:id="@+id/etDosen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nama Dosen"/>
        </com.google.android.material.textfield.TextInputLayout>

        <Switch
            android:id="@+id/switchReminder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aktifkan Reminder"
            android:checked="true"
            android:layout_marginTop="8dp"/>
    </LinearLayout>
</ScrollView>